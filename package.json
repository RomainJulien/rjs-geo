{
  "name": "@rjs/geo",
  "version": "0.1.0",
  "type": "module",
  "description": "Couche GEO/SEO partagée pour les sites Astro RJS Studio : graphe JSON-LD relié par @id, endpoint llms.txt, schémas Zod, composant AnswerBlock et conseils SEO/GEO au build.",
  "author": "RJS Studio",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomainJulien/rjs-geo.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AnswerBlock.astro": "./src/AnswerBlock.astro"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/AnswerBlock.astro"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "peerDependencies": {
    "astro": ">=5",
    "zod": "^3 || ^4"
