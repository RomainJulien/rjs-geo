{
  "name": "@rjs/geo",
  "version": "0.4.0",
  "type": "module",
  "description": "Pack SEO/GEO partagé des sites Astro RJS Studio : config unique par site (defineSite), <SeoHead>, graphe JSON-LD relié par @id, robots.txt, llms.txt, sitemap, redirections, lien RJS Studio, garde-fou au build, plugin Netlify IndexNow et CLI rjs-geo (init, check, launch Google/Bing/IndexNow, status, outils de portefeuille).",
  "author": "RJS Studio",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomainJulien/rjs-geo.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./SeoHead.astro": "./src/SeoHead.astro",
    "./RjsCredit.astro": "./src/RjsCredit.astro",
    "./Faq.astro": "./src/Faq.astro",
    "./AnswerBlock.astro": "./src/AnswerBlock.astro",
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "netlify-plugin",
    "src/*.astro",
    "src/virtual.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "peerDependencies": {
    "astro": ">=5",
    "zod": "^3 || ^4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "bin": {
    "rjs-geo": "./dist/cli.js"
  }
}
